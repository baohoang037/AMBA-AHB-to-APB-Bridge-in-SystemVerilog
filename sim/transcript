# vsim.wlf opened as dataset "vsim"
# add wave -r /*
#  radix -hex
# hexadecimal
# 
# stdin: <EOF>
# 1. Rút gọn tên tín hiệu (bỏ /top/DUT/ dài dòng)
config wave -signalnamewidth 1

# 2. Xóa các tín hiệu mặc định và thêm tín hiệu đã chia nhóm màu đẹp
delete wave *

add wave -divider "AHB INTERFACE"
add wave -color Cyan /top/DUT/Hclk /top/DUT/Hresetn /top/DUT/Hreadyin /top/DUT/Hreadyout /top/DUT/Htrans /top/DUT/Hwrite /top/DUT/Haddr /top/DUT/Hwdata /top/DUT/Hrdata

add wave -divider "BRIDGE PIPELINE & FSM"
add wave -color Orange /top/DUT/valid /top/DUT/APBControl/PRESENT_STATE /top/DUT/Haddr1 /top/DUT/Haddr2 /top/DUT/addr_outstanding_num

add wave -divider "APB INTERFACE"
add wave -color Green /top/DUT/Pselx /top/DUT/Penable /top/DUT/Pwrite /top/DUT/Paddr /top/DUT/Pwdata /top/DUT/Prdata

# 3. Phóng to vừa vặn vùng có giao dịch (từ 100ns đến 300ns)
wave zoom range 100ns 300ns
# {100 ns} {300 ns}
